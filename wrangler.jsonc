{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lobato",
  "main": "hosting/cloudflare.mjs",
  "compatibility_date": "2026-10-26",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none",
    "run_worker_first": ["/api/*"]
  }
}
